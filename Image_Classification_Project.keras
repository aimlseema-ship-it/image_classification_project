{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOAG6GWjUfHxj/xQMkhygNv"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0QfIk8ldjgTe","executionInfo":{"status":"ok","timestamp":1792302671742,"user_tz":-330,"elapsed":7390,"user":{"displayName":"seema shaik","userId":"15289728885836815461"}},"outputId":"cfa3a9a1-5d9c-4b38-ef9b-729cd5b1fdd3"},"outputs":[{"output_type":"stream","name":"stdout","text":["TensorFlow version: 2.21.0\n","GPU available: False\n"]}],"source":["import tensorflow as tf\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","print(\"TensorFlow version:\", tf.__version__)\n","print(\"GPU available:\", len(tf.config.list_physical_devices('GPU')) > 0)"]},{"cell_type":"code","source":["# Load the CIFAR-10 image dataset\n","(x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar10.load_data()\n","\n","class_names = [\n","    'airplane', 'automobile', 'bird', 'cat', 'deer',\n","    'dog', 'frog', 'horse', 'ship', 'truck'\n","]\n","\n","print(\"Training images:\", x_train.shape)\n","print(\"Testing images:\", x_test.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zMlb9rc5j8t2","executionInfo":{"status":"ok","timestamp":1792305745038,"user_tz":-330,"elapsed":100400,"user":{"displayName":"seema shaik","userId":"15289728885836815461"}},"outputId":"5ec7f86d-cab0-4fc2-eac8-b007113e7b52"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Downloading data from https://www.cs.toronto.edu/~kriz/cifar-10-python.tar.gz\n","\u001b[1m170498071/170498071\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m2972s\u001b[0m 17us/step\n","Training images: (50000, 32, 32, 3)\n","Testing images: (10000, 32, 32, 3)\n"]}]},{"cell_type":"code","source":["plt.figure(figsize=(10, 5))\n","\n","for i in range(10):\n","    plt.subplot(2, 5, i + 1)\n","    plt.imshow(x_train[i])\n","    plt.title(class_names[int(y_train[i][0])])\n","    plt.axis(\"off\")\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":473},"id":"ZIdDlsV-j8iq","executionInfo":{"status":"ok","timestamp":1792305745834,"user_tz":-330,"elapsed":784,"user":{"displayName":"seema shaik","userId":"15289728885836815461"}},"outputId":"f35b3ba5-917c-4a80-f427-67c0024ade88"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 10 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Normalize image pixel values from 0-255 to 0-1\n","x_train = x_train.astype(\"float32\") / 255.0\n","x_test = x_test.astype(\"float32\") / 255.0\n","\n","print(\"Training data shape:\", x_train.shape)\n","print(\"Testing data shape:\", x_test.shape)\n","print(\"Preprocessing completed successfully!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SRTohuZFj8Xt","executionInfo":{"status":"ok","timestamp":1792305762658,"user_tz":-330,"elapsed":627,"user":{"displayName":"seema shaik","userId":"15289728885836815461"}},"outputId":"6683e915-ac84-4550-a9ba-8dacebfe1d0c"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Training data shape: (50000, 32, 32, 3)\n","Testing data shape: (10000, 32, 32, 3)\n","Preprocessing completed successfully!\n"]}]},{"cell_type":"code","source":["from tensorflow.keras import layers, models\n","\n","data_augmentation = models.Sequential([\n","    layers.RandomFlip(\"horizontal\"),\n","    layers.RandomRotation(0.1)\n","])\n","\n","model = models.Sequential([\n","    layers.Input(shape=(32, 32, 3)),\n","    data_augmentation,\n","\n","    layers.Conv2D(32, (3, 3), activation=\"relu\", padding=\"same\"),\n","    layers.MaxPooling2D((2, 2)),\n","\n","    layers.Conv2D(64, (3, 3), activation=\"relu\", padding=\"same\"),\n","    layers.MaxPooling2D((2, 2)),\n","\n","    layers.Conv2D(128, (3, 3), activation=\"relu\", padding=\"same\"),\n","    layers.MaxPooling2D((2, 2)),\n","\n","    layers.Flatten(),\n","    layers.Dense(128, activation=\"relu\"),\n","    layers.Dropout(0.3),\n","    layers.Dense(10, activation=\"softmax\")\n","])\n","\n","model.compile(\n","    optimizer=\"adam\",\n","    loss=\"sparse_categorical_crossentropy\",\n","    metrics=[\"accuracy\"]\n",")\n","\n","model.summary()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":481},"id":"UR7qHioPj8OB","executionInfo":{"status":"ok","timestamp":1792305765657,"user_tz":-330,"elapsed":248,"user":{"displayName":"seema shaik","userId":"15289728885836815461"}},"outputId":"8c9fda7f-732a-4737-fe65-6d3136b0dcf8"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["\u001b[1mModel: \"sequential_1\"\u001b[0m\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\">Model: \"sequential_1\"</span>\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┓\n","┃\u001b[1m \u001b[0m\u001b[1mLayer (type)                   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOutput Shape          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m      Param #\u001b[0m\u001b[1m \u001b[0m┃\n","┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━┩\n","│ sequential (\u001b[38;5;33mSequential\u001b[0m)         │ (\u001b[38;5;45mNone\u001b[0m, \u001b[38;5;34m32\u001b[0m, \u001b[38;5;34m32\u001b[0m, \u001b[38;5;34m3\u001b[0m)      │             \u001b[38;5;34m0\u001b[0m │\n","├─────────────────────────────────┼────────────────────────┼───────────────┤\n","│ conv2d (\u001b[38;5;33mConv2D\u001b[0m)              